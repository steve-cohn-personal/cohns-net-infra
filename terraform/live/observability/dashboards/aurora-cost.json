{
  "uid": "cohns-aurora-cost",
  "title": "cohns.net — Aurora Serverless Cost (scale-to-zero)",
  "tags": ["cohns-net", "cost", "aurora"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "_comment": [
    "${cw} and ${db_cluster} are TERRAFORM templatefile placeholders, not Grafana",
    "template variables. dashboards.tf substitutes them at apply time with the",
    "CloudWatch datasource uid and the Aurora cluster id. The uid is injected (not a",
    "datasource variable) because this board is shared publicly and public dashboards",
    "don't resolve template variables — every panel would read 'Datasource was not",
    "found'. The cluster id is injected as an exact dimension (matchExact:true) so each",
    "query returns a single MetricStat series with a clean label. The cost panel's",
    "'x $0.12' is a client-side calculateField transformation, NOT CloudWatch metric",
    "math: Grafana PUBLIC dashboards return 500 on a CloudWatch math expression (the",
    "raw GetMetricData math works fine when queried directly — it's a public-dash limit)."
  ],
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Aurora capacity (ACU) — watch it fall to zero when idle",
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 0 },
      "datasource": { "type": "cloudwatch", "uid": "${cw}" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "custom": { "fillOpacity": 20, "lineWidth": 2, "gradientMode": "opacity" } } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "cloudwatch", "uid": "${cw}" },
          "namespace": "AWS/RDS",
          "metricName": "ServerlessDatabaseCapacity",
          "statistic": "Average",
          "dimensions": { "DBClusterIdentifier": "${db_cluster}" },
          "matchExact": true,
          "region": "default",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "label": "ACU — ${db_cluster}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Estimated DB compute cost / hour",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "cloudwatch", "uid": "${cw}" },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.25 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/hour/" },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "cloudwatch", "uid": "${cw}" },
          "namespace": "AWS/RDS",
          "metricName": "ServerlessDatabaseCapacity",
          "statistic": "Average",
          "dimensions": { "DBClusterIdentifier": "${db_cluster}" },
          "matchExact": true,
          "region": "default",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "label": "ACU"
        }
      ],
      "transformations": [
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "binary": { "left": "ACU", "operator": "*", "right": "0.12" },
            "alias": "$ / hour (ACU x $0.12)",
            "replaceFields": true
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Database connections",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 9 },
      "datasource": { "type": "cloudwatch", "uid": "${cw}" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "custom": { "fillOpacity": 5, "lineWidth": 2 } } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "cloudwatch", "uid": "${cw}" },
          "namespace": "AWS/RDS",
          "metricName": "DatabaseConnections",
          "statistic": "Maximum",
          "dimensions": { "DBClusterIdentifier": "${db_cluster}" },
          "matchExact": true,
          "region": "default",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "label": "connections — ${db_cluster}"
        }
      ]
    }
  ]
}
