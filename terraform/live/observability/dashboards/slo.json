{
  "uid": "cohns-slo",
  "title": "cohns.net — Availability & Latency (SLO)",
  "tags": ["cohns-net", "synthetics", "slo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "_comment": [
    "${prom} is a TERRAFORM templatefile placeholder, not a Grafana template variable.",
    "It is substituted with the Prometheus datasource uid at apply time by dashboards.tf.",
    "This dashboard is shared publicly, and public dashboards do not resolve Grafana",
    "template variables — a datasource variable here renders every panel as",
    "'Datasource was not found'. Keep the uid injected at apply time instead."
  ],
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Availability (selected range)",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${prom}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 99,
          "max": 100,
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 99.5 },
              { "color": "green", "value": 99.9 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${prom}" },
          "expr": "avg(avg_over_time(probe_success[$__range])) * 100",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Uptime by endpoint",
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${prom}" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 1, "custom": { "fillOpacity": 10, "lineWidth": 2 } } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${prom}" },
          "expr": "avg by (job) (probe_success)",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Response time by probe location",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${prom}" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 5, "lineWidth": 2 } } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${prom}" },
          "expr": "avg by (probe, job) (probe_duration_seconds)",
          "legendFormat": "{{job}} — {{probe}}"
        }
      ]
    }
  ]
}
